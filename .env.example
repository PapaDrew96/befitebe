# Application
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Europe/Athens
APP_BASE_PATH=
APP_URL=http://befitapi.test:8082

# Generate a unique production key with:
# /opt/plesk/php/8.3/bin/php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=
APP_ALLOWED_HOSTS=befitapi.test
TRUSTED_PROXIES=
MAX_REQUEST_BODY_BYTES=65536
REQUIRE_JSON_WRITES=true

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=befit_app
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Sessions / authentication
TOKEN_TTL_DAYS=7
TOKEN_IDLE_TTL_MINUTES=1440
TOKEN_MAX_ACTIVE_PER_USER=5
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_IP_RATE_LIMIT_ATTEMPTS=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_MIN_LENGTH=12
PASSWORD_ARGON_MEMORY_KB=65536
PASSWORD_ARGON_TIME_COST=4
PASSWORD_ARGON_THREADS=2
PASSWORD_BCRYPT_COST=12

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_IP_RATE_LIMIT_ATTEMPTS=20
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_BASE_URL=http://befit.test:8082

# Mail
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@befit.test
MAIL_FROM_NAME=BE-FIT Training Center

SCHEDULE_MAX_DAYS_AHEAD=120

# Exact browser origins only. Never use * in production.
CORS_ALLOWED_ORIGINS=http://befit.test:8082,http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=debug
LOG_FILE=storage/logs/app.log
