{
  "name": "befit/training-center-api",
  "description": "BE-FIT Training Center booking and attendance API",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "monolog/monolog": "^3.10",
    "phpmailer/phpmailer": "^7.1",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15.2",
    "vlucas/phpdotenv": "^5.6.4"
  },
  "autoload": {
    "psr-4": {
      "Befit\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
